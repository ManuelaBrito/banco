SET SERVEROUTPUT ON

DECLARE

BEGIN
    exec_ddl('TABLE IMOVEL_RURAL', q'[
        CREATE TABLE IMOVEL_RURAL (
            imo_id             NUMBER PRIMARY KEY,
            mun_id             NUMBER NOT NULL,
            arq_bruto_id       NUMBER NOT NULL,
            imo_codigo_car     VARCHAR2(50) NOT NULL UNIQUE,
            imo_geometria      SDO_GEOMETRY,
            imo_area_total     NUMBER(14, 4) CHECK (imo_area_total > 0),
            imo_data_informada DATE,
            CONSTRAINT fk_imo_municipio FOREIGN KEY (mun_id) REFERENCES MUNICIPIO(mun_id),
            CONSTRAINT fk_imo_arquivo_bruto FOREIGN KEY (arq_bruto_id) REFERENCES ARQUIVO_BRUTO(arq_bruto_id)
        )
    ]');

    -- 3. metadado espacial
    BEGIN
        INSERT INTO USER_SDO_GEOM_METADATA (table_name, column_name, diminfo, srid)
        VALUES (
            'IMOVEL_RURAL',
            'IMO_GEOMETRIA',
            SDO_DIM_ARRAY(
                SDO_DIM_ELEMENT('Longitude', -180, 180, 0.5),
                SDO_DIM_ELEMENT('Latitude',   -90,  90, 0.5)
            ),
            4674
        );
        COMMIT;
        DBMS_OUTPUT.PUT_LINE('criado   : METADATA IMOVEL_RURAL.IMO_GEOMETRIA');
    EXCEPTION
        WHEN DUP_VAL_ON_INDEX THEN
            DBMS_OUTPUT.PUT_LINE('ja existe: METADATA IMOVEL_RURAL.IMO_GEOMETRIA');
    END;

    -- 4. indice espacial
    exec_ddl('INDEX ix_imo_geometria', q'[
        CREATE INDEX ix_imo_geometria ON IMOVEL_RURAL(imo_geometria)
            INDEXTYPE IS MDSYS.SPATIAL_INDEX_V2
    ]');

    -- 5. comentarios
    exec_ddl('COMMENT imo_codigo_car', q'[
        COMMENT ON COLUMN IMOVEL_RURAL.imo_codigo_car IS
            'Codigo do Cadastro Ambiental Rural'
    ]');

    exec_ddl('COMMENT imo_area_total', q'[
        COMMENT ON COLUMN IMOVEL_RURAL.imo_area_total IS
            'Area total declarada, em hectares'
    ]');

    exec_ddl('COMMENT imo_data_informada', q'[
        COMMENT ON COLUMN IMOVEL_RURAL.imo_data_informada IS
            'Data informada na fonte, nao a data de carga'
    ]');
END;
/
